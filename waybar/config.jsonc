// Waybar de Hyprland Kora. Recargar en vivo: Super+Shift+B
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left": ["custom/logo", "clock", "hyprland/window"],
    "modules-center": ["custom/workspaces"],
    "modules-right": ["mpris", "tray", "group/estado", "custom/notif", "custom/power"],

    "custom/logo": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/hypr-kora/scripts/fuzzel.sh"
    },
    "custom/workspaces": {
        "exec": "~/.config/hypr-kora/scripts/workspaces.py",
        "return-type": "json",
        "escape": false,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "music": "󰓇", "special:music": "󰓇", "discord": "󰙯", "special:discord": "󰙯", "obs": "󰑋", "special:obs": "󰑋", "gaming": "󰊴", "special:gaming": "󰊴",
            "active": "", "default": ""
        },
        "show-special": true,
        "persistent-workspaces": { "*": 5 },
        "on-scroll-up": "hyprctl dispatch workspace m-1",
        "on-scroll-down": "hyprctl dispatch workspace m+1"
    },
    "hyprland/window": {
        "format": "{title}",
        "icon": true,
        "icon-size": 16,
        "max-length": 50,
        "separate-outputs": true,
        "rewrite": { "": "Escritorio" }
    },
    "clock": {
        "format": "<span color='#ece4d4'>󰃭  {0:L%A %d de %B}</span>   <span color='#6b6255'>│</span>   <span color='#e6b450' weight='bold'>󰥔  {0:%H:%M}</span>",
        "format-alt": "<span color='#ece4d4'>󰃭  {0:%d/%m/%Y}</span>   <span color='#6b6255'>│</span>   <span color='#e6b450' weight='bold'>󰥔  {0:%H:%M:%S}</span>",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "locale": "es_MX.UTF-8"
    },
    "mpris": {
        "format": "{status_icon}  {title}",
        "format-stopped": "",
        "status-icons": { "playing": "󰐊", "paused": "󰏤", "stopped": "" },
        "max-length": 30
    },
    "tray": { "spacing": 8 },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format": "{essid}  ·  {ipaddr}",
        "on-click": "~/.config/hypr-kora/scripts/centro.sh",
        "on-click-right": "kitty -e nmtui"
    },
    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },
    "group/estado": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth", "pulseaudio", "battery"]
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "~/.config/hypr-kora/scripts/centro.sh"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "tooltip-format": "Volumen {volume}%",
        "on-click": "~/.config/hypr-kora/scripts/centro.sh",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/notif": {
        "exec": "~/.config/hypr-kora/scripts/notif-waybar.sh",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "~/.config/hypr-kora/scripts/centro.sh",
        "on-click-right": "qs -p ~/.config/hypr-kora/centro ipc call centro dnd"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/hypr-kora/scripts/power-menu.sh"
    }
}
