// Waybar de Hyprland Kora. Recargar en vivo: Super+Shift+B
{
    "layer": "bottom",   // debajo de ventanas: pantalla completa y emergentes la tapan
    "position": "top",
    "height": 54,
    "spacing": 6,
    "reload_style_on_change": true,   // style.css se aplica en vivo al cambiar de tema (sin reiniciar la barra)

    "modules-left": ["custom/logo", "clock", "group/sistema", "hyprland/window"],
    "modules-center": ["custom/workspaces"],
    "modules-right": ["custom/cava", "group/estado", "custom/notif", "custom/power"],

    "custom/logo": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/hypr-kora/scripts/fuzzel.sh"
    },
    "custom/workspaces": {
        "exec": "~/.config/hypr-kora/scripts/workspaces.py",
        "restart-interval": 1,
        "return-type": "json",
        "escape": false,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "music": "󰓇", "special:music": "󰓇", "discord": "󰙯", "special:discord": "󰙯", "obs": "󰑋", "special:obs": "󰑋", "gaming": "󰊴", "special:gaming": "󰊴",
            "active": "", "default": ""
        },
        "show-special": true,
        "on-scroll-up": "hyprctl dispatch workspace m-1",
        "on-scroll-down": "hyprctl dispatch workspace m+1"
    },
    "hyprland/window": {
        "format": "{title}",
        "icon": true,
        "icon-size": 16,
        "max-length": 26,
        "separate-outputs": true,
        "rewrite": { "": "Escritorio" }
    },
    "clock": {
        "format": "󰥔  {0:%H:%M}",
        "format-alt": "󰥔  {0:%H:%M:%S}",
        "tooltip-format": "<span size='14pt' color='#91bfa8'><b>{0:L%A %d de %B}</b></span>\n<span color='#5d635d'>─────────────────────</span>\n<tt><big>{calendar}</big></tt>",
        "interval": 1,
        "locale": "es_MX.UTF-8",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#dde3dd'><b>{}</b></span>",
                "weekdays": "<span color='#91bfa8'><b>{}</b></span>",
                "days": "<span color='#dde3dd'>{}</span>",
                "today": "<span background='#91bfa8' color='#111211'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up",
            "on-click-right": "mode"
        }
    },
    "mpris": {
        "format": "{status_icon}  {title}",
        "format-stopped": "",
        "status-icons": { "playing": "󰐊", "paused": "󰏤", "stopped": "" },
        "max-length": 30
    },
    "tray": { "spacing": 8 },
    "custom/cava": {
        "exec": "~/.config/hypr-kora/scripts/cava-waybar.sh",
        "restart-interval": 2,
        "tooltip": false,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format": "{essid}  ·  {ipaddr}",
        "on-click": "~/.config/hypr-kora/scripts/centro.sh",
        "on-click-right": "nm-connection-editor"
    },
    "battery": {
        "states": { "warning": 25, "critical": 12 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}\nClic: modo de energía",
        "on-click": "~/.config/hypr-kora/scripts/energia.sh"
    },
    "group/sistema": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "disk", "temperature"]
    },
    "cpu": { "format": "󰻠 {usage}%", "interval": 2, "tooltip-format": "Procesador · clic: Monitor", "on-click": "~/.config/hypr-kora/scripts/monitor.sh" },
    "memory": { "format": "󰍛 {percentage}%", "interval": 3, "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB · clic: Monitor", "on-click": "~/.config/hypr-kora/scripts/monitor.sh" },
    "disk": { "format": "󰋊 {percentage_used}%", "path": "/", "interval": 60, "tooltip-format": "Disco: {used} / {total} · clic: Monitor", "on-click": "~/.config/hypr-kora/scripts/monitor.sh" },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "󰔏 {temperatureC}°",
        "format-critical": "󰈸 {temperatureC}°",
        "interval": 3,
        "tooltip-format": "Temperatura del procesador · clic: Monitor",
        "on-click": "~/.config/hypr-kora/scripts/monitor.sh"
    },
    "group/estado": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth", "pulseaudio", "battery"]
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "~/.config/hypr-kora/scripts/centro.sh"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "tooltip-format": "Volumen {volume}%",
        "on-click": "~/.config/hypr-kora/scripts/centro.sh",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/notif": {
        "exec": "~/.config/hypr-kora/scripts/notif-waybar.sh",
        "return-type": "json",
        "signal": 8,
        "interval": "once",
        "on-click": "~/.config/hypr-kora/scripts/centro.sh",
        "on-click-right": "qs -p ~/.config/hypr-kora/centro ipc call centro dnd"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/hypr-kora/scripts/power-menu.sh"
    }
}
