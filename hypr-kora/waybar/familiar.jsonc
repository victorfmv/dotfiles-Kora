// Waybar del modo Familiar (scripts/familiar.sh). Toma todo de config.jsonc y solo cambia
// el acomodo: más delgada, reloj al centro y los lados EN ESPEJO (Victor lo quiere simétrico):
//   logo ↔ apagar · ventana ↔ rayitas (mismo ancho) · workspaces ↔ estado (mismo ancho)
{
    "include": ["~/.config/hypr-kora/waybar/config.jsonc"],
    "height": 40,
    "margin-top": 6, "margin-left": 12, "margin-right": 12,
    "spacing": 4,
    "modules-left": ["custom/logo", "custom/ventana", "custom/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["group/estado", "custom/cava", "custom/power"],
    "group/estado": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth", "pulseaudio", "battery", "custom/notif"]
    }
}
