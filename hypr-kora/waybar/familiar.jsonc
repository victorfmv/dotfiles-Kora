// Waybar del modo Familiar (scripts/familiar.sh). Toma todo de config.jsonc y solo cambia
// el acomodo: más delgada, menos módulos, el reloj al centro como "isla".
{
    "include": ["~/.config/hypr-kora/waybar/config.jsonc"],
    "height": 40,
    "margin-top": 6, "margin-left": 12, "margin-right": 12,
    "spacing": 4,
    "modules-left": ["custom/logo", "custom/ventana", "custom/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/cava", "group/estado", "custom/power"]
}
